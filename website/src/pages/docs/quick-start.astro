---
import Doc from '../../layouts/Doc.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { firstRequest, version, release, docHref } from '../../lib/site';
const platforms = [
  {
    key: 'homebrew',
    name: 'Homebrew',
    code: 'brew install juanfontes/tap/curlimp\ncurlimp -sS -I https://httpbin.org/status/200',
    note: 'Requires Homebrew. Supports Linux amd64/arm64 and experimental macOS Apple Silicon. Installs the native command and Zsh completion; no separate brew tap command is needed.',
  },
  {
    key: 'docker',
    name: 'Docker',
    code: firstRequest,
    note: 'Docker downloads the image automatically on first use.',
  },
  {
    key: 'linux',
    name: 'Linux',
    code: `tar -xzf curlimp-${version}-linux-amd64.tar.gz\n./curlimp-${version}-linux-amd64/curlimp \\\n  -sS -I https://httpbin.org/status/200`,
    note: 'After downloading and verifying the bundle. Replace amd64 with arm64 on ARM Linux.',
  },
  {
    key: 'macos',
    name: 'macOS',
    code: `tar -xzf curlimp-${version}-macos-arm64.tar.gz\n./curlimp-${version}-macos-arm64/curlimp \\\n  -sS -I https://httpbin.org/status/200`,
    note: 'After downloading and verifying the Apple Silicon bundle. Native macOS support is experimental.',
  },
];
---

<Doc
  title="Quick start"
  slug="quick-start"
  section="Getting started"
  description="Make your first browser-profile HTTP request with curlimp. Install with Homebrew, run Docker or a native bundle, and choose a browser profile."
  lead="Send your first request with browser-specific TLS and HTTP settings. Chrome 150 and response decompression are enabled by default."
>
  <section>
    <h2>Make your first request</h2>
    <div class="install-tabs" data-tabs>
      <div
        class="tab-list"
        data-tab-list
        aria-label="Installation platform"
        hidden
      >
        {platforms.map((p) => (
          <button
            type="button"
            id={`tab-${p.key}`}
            data-tab
            aria-controls={`panel-${p.key}`}
          >
            {p.name}
          </button>
        ))}
      </div>
      {platforms.map((p) => (
        <div class="tab-panel" data-panel id={`panel-${p.key}`} tabindex="0">
          <h3 class="panel-heading">{p.name}</h3>
          <CodeBlock code={p.code} />
          <p class="caption">{p.note}</p>
        </div>
      ))}
    </div>
    <p class="caption">
      Homebrew: see{' '}
      <a href={`${docHref('installation')}#homebrew`}>
        setup, updates, and uninstall
      </a>
      . Manual downloads: <a href={release}>download the release</a> and follow
      the <a href={docHref('installation')}>checksum and installation guide</a>.
    </p>
  </section>
  <p>
    Run <code>curlimp</code> or <code>curlimp --help</code> for the built-in
    guide and examples. With Docker, use{' '}
    <code>docker run --rm juanfontes/curlimp</code>.
  </p>
  <section>
    <h2>Use curlimp with Zsh autocomplete</h2>
    <p>
      <strong>Installed with Homebrew?</strong> The completion file is already
      installed. To register it in the current Zsh session, follow the
      installer's tip after your shell has initialized completion with{' '}
      <code>compinit</code>:
    </p>
    <CodeBlock code="source <(curlimp --completions zsh)" lang="zsh" />
    <p>
      Future sessions load the installed file if your Zsh setup loads Homebrew
      completions. There is no need to add the source command to{' '}
      <code>~/.zshrc</code> for that setup. See the{' '}
      <a href={`${docHref('completion')}#homebrew-installations`}>
        Homebrew completion guide
      </a>{' '}
      if completion is not configured yet.
    </p>
    <p>
      <strong>Downloaded a native bundle manually?</strong> Follow the{' '}
      <a href={docHref('installation')}>PATH instructions</a> and{' '}
      <a href={`${docHref('completion')}#downloaded-native-bundles`}>
        manual completion setup
      </a>
      .
    </p>
    <p>
      Once completion is loaded, type <code>curlimp </code> and press Tab to
      list profiles, or type any prefix such as <code>chrome1</code> before Tab
      to filter them. The first Tab may expand a shared prefix; press Tab again
      for the matches. The{' '}
      <a href={docHref('completion')}>autocomplete guide</a> also shows how to
      enable a selection menu.
    </p>
    <p>
      For Docker, use the full <code>docker run</code> command with the same
      request options. See the <a href={docHref('docker')}>Docker guide</a> for
      file mounts and stdin.
    </p>
  </section>
  <section>
    <h2>Choose a browser profile</h2>
    <p>
      Put an exact profile name before the URL, or use{' '}
      <code>--impersonate</code>.
    </p>
    <CodeBlock
      code={
        '# Request only the headers with Firefox\ncurlimp firefox147 -sS -I https://httpbin.org/status/200'
      }
    />
  </section>
  <section>
    <h2>See the response status</h2>
    <p>
      <code>/status/200</code> intentionally returns an empty body. A blank
      terminal can be a successful request. Print the status to check:
    </p>
    <CodeBlock
      code={
        "curlimp -sS -o /dev/null -w '%{http_code}\\n' https://httpbin.org/status/200"
      }
    />
    <p>
      This prints <code>200</code>. Try <code>/status/404</code> or{' '}
      <code>/status/502</code> to inspect an error response. They are deliberate
      HTTP errors, not connection failures.
    </p>
    <p>
      Continue with <a href={docHref('body-and-headers')}>body and headers</a>,{' '}
      <a href={docHref('redirects-and-status')}>redirects and status codes</a>,
      or the <a href={docHref('docker')}>Docker and file-path guide</a>.
    </p>
  </section>
</Doc>
